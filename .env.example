# Makro Ortodonti — environment configuration template.
# Copy to .env and fill in real values. Never commit the real .env file.

# --- Core security (required in production; app refuses to start with
# missing/short/placeholder values — see app/config.py is_insecure_secret) ---
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-with-a-long-random-secret
# Used by app/services/security_service.py (Fernet) to encrypt sensitive
# settings such as the SMTP password. Changing this after first use makes
# any previously-encrypted values permanently undecryptable.
ENCRYPTION_KEY=replace-with-a-long-random-secret

# --- Flask runtime ---
FLASK_DEBUG=false
TESTING=false

# --- Database ---
# Defaults to data/makroortodonti.db (SQLite) if unset.
DATABASE_URL=

# --- SMTP (for e-mail sending; optional) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Reverse proxy / cookies ---
# Set to true only when running behind a trusted reverse proxy (nginx, etc.)
TRUST_PROXY=false
SESSION_COOKIE_SECURE=false
FORCE_HSTS=false

# --- Misc ---
MAX_PAGE_SIZE=100
AUDIT_RETENTION_DAYS=3650

# --- Observability (optional) ---
SENTRY_DSN=

# --- First-run seeding (optional) ---
# Only used if you want a specific admin password instead of a securely
# generated one on first `flask db-tools seed`. Rejected outside DEBUG/TESTING
# if it looks weak/placeholder — see app/models/seeds.py _resolve_admin_password.
DEFAULT_ADMIN_PASSWORD=
